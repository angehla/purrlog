rules_version = '2';
// Purrlog: anyone with the app can read and log, no sign-in.
// The rules only keep the data in Purrlog's own shape.
service cloud.firestore {
  match /databases/{database}/documents {

    match /cats/{catId} {
      allow read: if true;
      allow create, update: if catId in ['oreo', 'louis']
        && request.resource.data.keys().size() <= 20
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
      // Cats can't be deleted: Oreo and Louis are the only cats.
    }

    match /logs/{logId} {
      allow read: if true;
      allow create, update: if request.resource.data.catId in ['oreo', 'louis']
        && request.resource.data.kind in ['chonk', 'play', 'poop', 'barf']
        && request.resource.data.at is string
        && request.resource.data.keys().size() <= 20
        && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 500);
      allow delete: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if docId == 'main' && request.resource.data.keys().size() <= 20;
    }
  }
}
